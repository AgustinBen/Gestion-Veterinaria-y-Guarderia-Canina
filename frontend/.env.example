# Copiar a frontend/.env.local para desarrollo local.
# El login real llega con T-10; hasta entonces estas variables alimentan el mock.

# Rol que devuelve el login provisorio: DUENIO | PERSONAL | VETERINARIO
VITE_MOCK_ROL=DUENIO
# Token ficticio guardado en la sesión provisoria
VITE_MOCK_TOKEN=token-mock
# Nombre visible del usuario provisorio (opcional)
VITE_MOCK_USUARIO=Usuario de prueba

# URL base de la API. Si se deja vacía se usa /api (proxy de Vite en desarrollo).
VITE_API_URL=
