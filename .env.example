# Copiar a backend/.env y completar los valores reales.
# Nunca subir el archivo .env real al repositorio.

DATABASE_URL=sqlite:///./huellitas.db
SECRET_KEY=ejemplo-no-seguro-cambiar-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=60

# Migración (T-15 perfilado y T-16 carga)
# EXCEL_ORIGEN apunta al archivo .xlsx; MIGRACION_SALIDA es el directorio de reportes.
EXCEL_ORIGEN=data/planilla.xlsx
MIGRACION_SALIDA=data/reportes
